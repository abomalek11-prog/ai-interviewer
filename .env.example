# ==========================================
# AI INTERVIEWER - ENVIRONMENT CONFIGURATION
# ==========================================

# ------------------------------------------
# General App Configuration
# ------------------------------------------
PROJECT_NAME=AI Interviewer
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=http://localhost:5173
FRONTEND_BASE_URL=http://localhost:5173
OAUTH_REDIRECT_BASE_URL=http://localhost:8000

# ------------------------------------------
# Database Connection
# ------------------------------------------
# PostgreSQL Example:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ai_interviewer
# SQLite Example:
DATABASE_URL=sqlite:///./dev.db

# ------------------------------------------
# Security & JWT Configuration
# ------------------------------------------
# Generate a strong secret: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-to-a-long-random-secret-key-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------------------
# AI Provider Configuration (OpenRouter / OpenAI / Profiles)
# ------------------------------------------
# OpenRouter (recommended, has free models): create a key at https://openrouter.ai/keys
# When set, these models are tried first, in order; a rate-limited model falls through
# to the next. OpenRouter has no speech endpoints, so voice uses the browser's own
# speech recognition / synthesis (Chrome or Edge).
OPENROUTER_API_KEY=
OPENROUTER_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,nvidia/nemotron-3-super-120b-a12b:free,openrouter/free

# OpenAI (optional, paid): also used for Whisper transcription and TTS voice when set.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_MODEL_PROFILE_ID=default
AI_FALLBACK_ENABLED=true

# Live Voice & Vision Interview Settings
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy
OPENAI_VISION_MODEL=gpt-4o-mini

# Multiple AI Profiles Configuration (Optional)
# Format: id|label|model|api_key_env;id2|label2|model2|api_key_env2
AI_MODEL_PROFILES=fast|Fast Interviewer|gpt-4.1-mini|OPENAI_API_KEY_FAST;smart|Smart Interviewer|gpt-4.1|OPENAI_API_KEY_SMART
OPENAI_API_KEY_FAST=
OPENAI_API_KEY_SMART=

# ------------------------------------------
# OAuth Login Providers (Optional)
# ------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

X_CLIENT_ID=
X_CLIENT_SECRET=

APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# ------------------------------------------
# Email & OTP Verification (Optional)
# ------------------------------------------
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@interviewai.app

# ------------------------------------------
# Frontend Environment Variables
# ------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api/v1
